# Ollama reverse proxy configuration
# This should be placed at ./nginx/conf.d/ollama.conf

# HTTP server block - redirects to HTTPS
server {
    listen 80;
    server_name ollama.local;

    # Log settings
    access_log /var/log/nginx/ollama.access.log main;
    error_log /var/log/nginx/ollama.error.log warn;

    # Redirect all HTTP traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server block
server {
    listen 443 ssl;
    server_name ollama.local;

    # SSL certificates
    ssl_certificate /etc/nginx/certs/ollama.crt;
    ssl_certificate_key /etc/nginx/certs/ollama.key;

    # Log settings
    access_log /var/log/nginx/ollama.access.log main;
    error_log /var/log/nginx/ollama.error.log warn;

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy no-referrer-when-downgrade;

    # Increase max upload size for model uploads
    client_max_body_size 10G;
    
    # Increase timeouts for model loading/inference
    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;
    
    # Main proxy configuration
    location / {
        proxy_pass http://ollama:11434;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    
    # Health check endpoint
    location /health {
        proxy_pass http://ollama:11434/api/version;
        proxy_set_header Host $host;
        access_log off;
    }
}