# Example service proxy configuration
# This should be placed at ./nginx/conf.d/app1.conf
server {
    listen 80;
    server_name app1.local;

    # Log settings
    access_log /var/log/nginx/app1.access.log main;
    error_log /var/log/nginx/app1.error.log warn;

    # Redirect to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name app1.local;

    # SSL certificates
    ssl_certificate /etc/nginx/certs/app1.crt;
    ssl_certificate_key /etc/nginx/certs/app1.key;

    # Log settings
    access_log /var/log/nginx/app1.access.log main;
    error_log /var/log/nginx/app1.error.log warn;

    # Security headers
    add_header X-Content-Type-Options nosniff;
    add_header X-Frame-Options SAMEORIGIN;
    add_header X-XSS-Protection "1; mode=block";
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Referrer-Policy no-referrer-when-downgrade;

    # Proxy settings for a backend service
    location / {
        proxy_pass http://app1-service:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
        proxy_read_timeout 60s;
        proxy_connect_timeout 15s;
    }

    # Special location for API endpoints with different timeout
    location /api/ {
        proxy_pass http://app1-api-service:8081/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
        proxy_connect_timeout 30s;
    }

    # Serve static files directly
    location /static/ {
        alias /usr/share/nginx/html/app1/static/;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000";
    }
}